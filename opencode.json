{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "instructions": [
    "./.opencode/TOOLS.md",
    "./.opencode/AGENTS.md",
    "./.opencode/brief-simulador.md",
    "./.opencode/git-tool.md"
  ],
  "skills": [
    "./runtime-skills",
    "./.opencode/tools-skills",
    "./.opencode/metodologia-skills"
  ],
  "mcp": {
    "lovable-tools": {
      "type": "local",
      "command": [
        "bun",
        ".opencode/mcp/imagegen-server.ts"
      ],
      "enabled": true
    },
    "mcp-gateway": {
      "type": "local",
      "command": [
        "bun",
        "./.opencode/mcp/gateway.ts"
      ],
      "env": {
        "PROJECT_ROOT": ".",
        "NODE_ENV": "development",
        "BUN_ENV": "development"
      },
      "enabled": true
    },
    "mcp-projectops": {
      "type": "local",
      "command": [
        "bun",
        "./.opencode/mcp/projectops.ts"
      ],
      "env": {
        "HEALTHCHECK_PATH": "./.opencode-healthcheck"
      },
      "enabled": true
    },
    "browser-playwright": {
      "type": "local",
      "command": [
        "bunx",
        "@modelcontextprotocol/server-playwright"
      ],
      "env": {
        "VITE_PROXY_URL": "http://localhost:5173",
        "HEADLESS": "true"
      },
      "enabled": true
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "skill": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "question": "allow",
    "edit": "allow",
    "write": "allow",
    "bash": "ask",
    "lovable-tools_*": "allow",
    "browser-playwright_*": "allow",
    "mcp-projectops_get_*": "allow",
    "mcp-projectops_read_*": "allow",
    "mcp-projectops_commit_*": "ask",
    "mcp-projectops_checkout_*": "ask",
    "mcp-gateway_*": "ask"
  },
  "agent": {
    "explorer": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "instructions": "Você é um explorador de código. Apenas investigue a arquitetura e responda diagnósticos. NUNCA altere arquivos nem rode comandos no terminal.",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "deny"
      }
    },
    "security-auditor": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "instructions": "Você foca exclusivamente em triagem de vulnerabilidades, dependências e secrets expostos.",
      "permission": {
        "read": "allow",
        "bash": "ask",
        "write": "deny"
      }
    }
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/*.zip",
      "./.opencode/tools-skills.zip"
    ]
  }
}
